# crm-document-ingestion settings. Copy to .env and fill in what you need.
# Every value is optional for local development: with the Microsoft values empty,
# local-file ingestion works and SharePoint calls fail fast with a clear error.

# ---- Microsoft Graph (OneDrive / SharePoint) -----------------------------------------
# Entra ID app registration using client credentials (application permissions,
# e.g. Files.Read.All / Sites.Read.All, admin-consented).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Override only for sovereign clouds (e.g. https://graph.microsoft.us/v1.0).
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_AUTHORITY_HOST=https://login.microsoftonline.com
MICROSOFT_GRAPH_TIMEOUT_SECONDS=30
# Largest file downloaded from Graph, in bytes (default 100 MB).
MICROSOFT_MAX_DOWNLOAD_BYTES=104857600

# ---- document-extractor ----------------------------------------------------------------
# Optional TOML settings file for the extraction library (read by document-extractor itself).
# DOCUMENT_EXTRACTOR_CONFIG=/path/to/document_extractor.toml
# fast (no OCR) | balanced | accurate. Used when DOCUMENT_EXTRACTOR_CONFIG is not set.
CRM_EXTRACTION_MODE=balanced

# ---- CRM extraction ---------------------------------------------------------------------
# Entities below this confidence are reported as validation warnings.
CRM_MIN_CONFIDENCE=0.5
# JSON list of client entity schema files (see README "Adding a client schema").
# CRM_SCHEMA_PATHS=["schemas/client.json"]
