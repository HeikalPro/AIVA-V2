# ─── Oracle Database ──────────────────────────────────────────────────────────
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=kb_user
ORACLE_PASSWORD=your_oracle_password

# Oracle Wallet (optional — only needed for mTLS / cloud wallets)
# ORACLE_WALLET_DIR=/path/to/wallet
# ORACLE_WALLET_PASSWORD=your_wallet_password

# Connection pool size
POOL_MIN=1
POOL_MAX=8

# Optional: fail a stuck Oracle call after N ms (e.g. 120000). Omit for no limit.
# ORACLE_CALL_TIMEOUT_MS=120000

# ─── OpenAI / Embedder ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Optional: default USD per 1M input tokens for job cost estimates
# EMBEDDING_DEFAULT_USD_PER_MILLION_TOKENS=0.02

# ─── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080

# Optional: require X-API-Key header for mutating routes
# ADMIN_API_KEY=your_admin_key

# ─── Async Job Queue (Redis) ──────────────────────────────────────────────────
# Leave blank to run ingest jobs inline (no worker needed)
REDIS_URL=redis://localhost:6379/0
REDIS_JOB_QUEUE=embedding_service:jobs

# ─── Search Defaults ──────────────────────────────────────────────────────────
SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_TOP_K=50

# ─── Ingest Tuning ────────────────────────────────────────────────────────────
INGEST_BATCH_EMBED_SIZE=64
JOB_POLL_INTERVAL_SEC=0.5

# Debug: per-line + per-merge Oracle timings during ingest (set false in prod)
INGEST_VERBOSE_LOG=false
