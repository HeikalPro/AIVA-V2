**/*.egg-info
crm-document-ingestion/.env
# The WITH_DOC_INTEL=1 build installs crm-document-ingestion from its source: pip needs src/,
# pyproject.toml and README.md (the package readme), not the tests or a local wheels/ folder.
crm-document-ingestion/tests/
crm-document-ingestion/wheels/
!crm-document-ingestion/README.md
