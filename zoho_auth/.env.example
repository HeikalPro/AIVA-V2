# Copy this file to .env in this same folder (zoho_auth/) and fill in real values.
# Never commit .env.

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/api/auth/zoho/callback

ZOHO_AUTH_URL=https://accounts.zoho.com/oauth/v2/auth
ZOHO_TOKEN_URL=https://accounts.zoho.com/oauth/v2/token
ZOHO_USER_INFO_URL=https://accounts.zoho.com/oauth/user/info

# Login + Zoho Mail send (re-authorize after changing scopes: python -m zoho_auth)
# Quotes required: commas in scope are truncated by dotenv without quotes
ZOHO_SCOPE="aaaserver.profile.READ,ZohoMail.messages.CREATE,ZohoMail.accounts.READ"

# Optional: comma-separated domains (no @). Empty = any email allowed.
# ZOHO_ALLOWED_EMAIL_DOMAIN=example.com

# Optional: how long a saved session may be reused before forcing browser login.
# ZOHO_SESSION_MAX_AGE_DAYS=7

# Optional: override where tokens are stored (default: zoho_auth/.zoho_login_tokens.json).
# ZOHO_TOKEN_STORE_PATH=

# Optional: for your own app (not read by zoho_auth); keep if you use it elsewhere.
# ZOHO_FRONTEND_REDIRECT_URL=http://localhost:5173/auth/zoho-callback
