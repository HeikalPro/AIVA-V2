 # Copy to backend/.env (and/or repo root .env for shared Oracle/LLM keys).

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=false
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://127.0.0.1:5173

# --- Oracle (AIVA app schema) ---
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=aiva_user
ORACLE_PASSWORD=change_me
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=20

# --- Bootstrap superadmin (created on startup if missing) ---
BOOTSTRAP_SUPERADMIN_ENABLED=true
BOOTSTRAP_SUPERADMIN_EMAIL=admin@aiva.local
BOOTSTRAP_SUPERADMIN_PASSWORD=change-me-strong-password
# BOOTSTRAP_SUPERADMIN_FIRST_NAME=AIVA
# BOOTSTRAP_SUPERADMIN_LAST_NAME=Super Admin
# BOOTSTRAP_SUPERADMIN_ORGANIZATION_CODE=AIVA
# BOOTSTRAP_SUPERADMIN_ORGANIZATION_NAME=AIVA

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute
# Auth flow (use 5/hour for signup in production per company standard)
RATE_LIMIT_SIGNUP=30/hour
RATE_LIMIT_RESEND_OTP=20/hour
RATE_LIMIT_FORGOT_PASSWORD=10/hour

# --- LLM (llm_service) ---
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# --- Embedding / RAG (embedding_service) ---
# Uses same ORACLE_* if KB lives on same DB; override if needed.
SEARCH_DEFAULT_TOP_K=10
# KB article links on agent answers: {base}/{external_parent_id}
# KB article links on agent answers — template + external_parent_id (no forced / slash).
# Examples: http://your-kb-host/kb/view.php?id=  → …view.php?id=158
#           http://your-kb-host/kb/article/{id}  → …/article/158
# Default when an account has no kb_source_base_url set.
KB_SOURCE_BASE_URL=
# Source links shown per answer (RAG may still retrieve more chunks for LLM context).
KB_SOURCE_MAX_COUNT=1

# --- Zoho OAuth login (disabled by default; set true + UI VITE_ENABLE_ZOHO_LOGIN=1 to re-enable) ---
ZOHO_LOGIN_ENABLED=false
# ZOHO_FRONTEND_REDIRECT_URL=http://localhost:5175/auth/zoho-callback
# Auto-register valid Zoho users who are not yet in AIVA_users:
# ZOHO_AUTO_REGISTER_ORGANIZATION_ID=1
# ZOHO_AUTO_REGISTER_ROLE=AGENT

# --- Zoho ticket sync (optional) ---
ZOHO_DESK_API_BASE=https://desk.zoho.com/api/v1
ZOHO_TICKET_SYNC_ENABLED=false

# --- SMTP (Resend or company mail server) — used for OTP, password reset, notifications ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=your-resend-api-key
SMTP_FROM_EMAIL=noreply@goai247.com
SMTP_FROM_NAME=GoAI247
SMTP_ENCRYPTION=ssl

OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESEND_PER_HOUR=5

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Agent-friendly defaults (set PASSWORD_REQUIRE_COMPLEXITY=true for stricter rules)
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_COMPLEXITY=false

APP_NAME=AIVA
APP_URL=http://localhost:5175

# Default org/role for self-service sign-up (uses bootstrap org if unset)
# SIGNUP_DEFAULT_ORGANIZATION_ID=1
SIGNUP_DEFAULT_ROLE=AGENT

# --- Developer email notifications ---
NOTIFY_DEVELOPERS_ENABLED=false
NOTIFY_SKIP_CREATOR=true
FRONTEND_URL=http://localhost:5175

# --- Server error alerts (email admins + developers on unhandled errors) ---
NOTIFY_ERRORS_ENABLED=false
# Suppress duplicate alerts for the same (exception type, route) within this many seconds.
NOTIFY_ERRORS_THROTTLE_SECONDS=300

# --- Server watchdog (scripts/watchdog.py, run from cron; see its docstring) ---
# Who gets the disk-full / database-down / app-down emails. Comma-separated.
# Listed here rather than looked up by role, because the watchdog has to work
# when the database is the thing that is down.
WATCHDOG_ALERT_EMAILS= adham_eelrefaie@gochat247.com,ahmed.heikal@gochat247.com
# WATCHDOG_DISK_PERCENT=80
# WATCHDOG_DISK_PATHS=/
# Empty checks http://127.0.0.1:$BACKEND_PORT/health; set "off" to skip the app check.
# WATCHDOG_HEALTH_URL=
# WATCHDOG_REPEAT_HOURS=6

# --- Database backup (scripts/backup_db.py, run weekly from cron; see its docstring) ---
# The result is emailed to WATCHDOG_ALERT_EMAILS above.
# BACKUP_DIR=/home/administrator/aiva-backups
# BACKUP_KEEP=8

# --- Zoho Mail fallback (only if SMTP is not configured) ---
ZOHO_MAIL_API_BASE=https://mail.zoho.com/api
ZOHO_MAIL_FROM_ADDRESS=
# ZOHO_MAIL_ACCOUNT_ID=optional_if_auto_resolve_fails

# --- Document intelligence (knowledge-document import + monitoring) ---
# See docs/document-intelligence-plan.md. The values shown are the built-in defaults; uncomment
# only what you change. Phase 2 settings (SharePoint sync, scheduler) are in the next block.
# The credentials encryption key never goes in this file.
# DOC_INTEL_ENABLED=true
# Uploaded originals + extracted text (relative paths resolve against AIVA-V2/). Include it in backups.
# DOC_INTEL_STORAGE_DIR=data/doc_intel
# DOC_INTEL_MAX_UPLOAD_MB=50
# DOC_INTEL_MAX_FILES_PER_UPLOAD=20
# DOC_INTEL_MAX_PAGES=300
# DOC_INTEL_MAX_CHUNKS=2000
# DOC_INTEL_EXTRACTION_TIMEOUT_SECONDS=900
# fast | balanced | accurate
# DOC_INTEL_EXTRACTION_MODE=balanced
# Tesseract language packs (apt install tesseract-ocr tesseract-ocr-ara tesseract-ocr-eng)
# DOC_INTEL_OCR_LANGUAGES=ara,eng
# Full path when tesseract is not on PATH, e.g. C:/Program Files/Tesseract-OCR/tesseract.exe
# DOC_INTEL_TESSERACT_CMD=
# DOC_INTEL_EXTRACTION_SMOKE_TIMEOUT_SECONDS=40
# DOC_INTEL_TIMEZONE=Africa/Cairo

# --- Document intelligence, Phase 2: SharePoint / OneDrive -> CRM ---
# Fernet key(s) that encrypt the stored Microsoft credentials. KEEP IT EMPTY HERE: set the real
# value only in the server's .env, never in the repository or the database. Generate one with
#   python -m backend.doc_intel.crypto generate-key
# and keep a copy in the team password manager: without the key the stored credentials cannot be
# decrypted and have to be entered again. While empty, saving or testing credentials is refused
# and Monitoring shows why; the rest of AIVA is unaffected. Rotation: put the new key first and the
# old one after it (comma separated), restart, re-save each source's credentials, then drop the old key.
DOC_INTEL_SECRETS_KEY=
# Microsoft endpoints: change only for a sovereign cloud (https only).
# DOC_INTEL_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# DOC_INTEL_GRAPH_AUTHORITY_HOST=https://login.microsoftonline.com
# DOC_INTEL_GRAPH_SCOPE=https://graph.microsoft.com/.default
# DOC_INTEL_GRAPH_TIMEOUT_SECONDS=30
# A source's site URL must be https and its host must end with one of these (comma separated).
# DOC_INTEL_SHAREPOINT_HOST_SUFFIXES=.sharepoint.com
# Caps per sync run: files listed, and the size of one downloaded file.
# DOC_INTEL_SYNC_MAX_FILES=5000
# DOC_INTEL_SYNC_MAX_FILE_MB=100
# Client CRM entity schemas on top of the generic ones: JSON files, comma separated
# (relative paths resolve against AIVA-V2/). Entities/fields below the confidence get a warning.
# DOC_INTEL_CRM_SCHEMA_PATHS=
# DOC_INTEL_CRM_MIN_CONFIDENCE=0.5
# Automatic syncs and periodic health checks. Off by default: a deployment opts in.
# DOC_INTEL_SCHEDULER_ENABLED=false
# DOC_INTEL_SCHEDULER_TICK_SECONDS=60
# DOC_INTEL_HEALTH_INTERVAL_MINUTES=15
