# Copy to backend/.env (and/or repo root .env for shared Oracle/LLM keys).

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=false
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Oracle (AIVA app schema) ---
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=aiva_user
ORACLE_PASSWORD=change_me
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=20

# --- Bootstrap superadmin (created on startup if missing) ---
BOOTSTRAP_SUPERADMIN_ENABLED=true
BOOTSTRAP_SUPERADMIN_EMAIL=admin@aiva.local
BOOTSTRAP_SUPERADMIN_PASSWORD=Admin@12345
# BOOTSTRAP_SUPERADMIN_FIRST_NAME=AIVA
# BOOTSTRAP_SUPERADMIN_LAST_NAME=Super Admin
# BOOTSTRAP_SUPERADMIN_ORGANIZATION_CODE=AIVA
# BOOTSTRAP_SUPERADMIN_ORGANIZATION_NAME=AIVA

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute

# --- LLM (llm_service) ---
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# --- Embedding / RAG (embedding_service) ---
# Uses same ORACLE_* if KB lives on same DB; override if needed.
SEARCH_DEFAULT_TOP_K=10

# --- Zoho OAuth login (configure secrets in zoho_auth/.env) ---
# ZOHO_FRONTEND_REDIRECT_URL=http://localhost:5173/auth/zoho-callback
# Auto-register valid Zoho users who are not yet in AIVA_users:
# ZOHO_AUTO_REGISTER_ORGANIZATION_ID=1
# ZOHO_AUTO_REGISTER_ROLE=AGENT

# --- Zoho ticket sync (optional) ---
ZOHO_DESK_API_BASE=https://desk.zoho.com/api/v1
ZOHO_TICKET_SYNC_ENABLED=false
